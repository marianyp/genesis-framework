{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_page_url}",
    "sources": "${mod_git_url}"
  },
  "license": "${mod_license}",
  "icon": "assets/genesisframework/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.mariany.genesisframework.GenesisFramework"
    ],
    "client": [
      "dev.mariany.genesisframework.client.GenesisFrameworkClient"
    ],
    "rei_client": [
      "dev.mariany.genesisframework.compat.rei.GenesisFrameworkREIPlugin"
    ],
    "jei_mod_plugin": [
      "dev.mariany.genesisframework.compat.jei.GenesisFrameworkJEIPlugin"
    ],
    "fabric-datagen": [
      "dev.mariany.genesisframework.GFDataGenerator"
    ]
  },
  "mixins": [
    "genesisframework.mixins.json",
    "genesisframework-jei.mixins.json"
  ],
  "accessWidener": "genesisframework.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.2",
    "java": ">=25",
    "fabric-api": ">=0.154.2"
  },
  "suggests": {
    "roughlyenoughitems": "*",
    "jei": "*"
  }
}
